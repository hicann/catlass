// RUN: sed -n '/BEGIN-VALID$/,/END-VALID$/p' %s | %tla_compile - --emit=tlair -o %t
// RUN: %tla_compile %t --emit=tlair -o - | %filecheck %s --check-prefix=VALID
// RUN: for t in I64 SI32 UI32 F64 INDEX TENSOR VECTOR PTR; do sed -n "/BEGIN-${t}$/,/END-${t}$/p" %s | not %tla_compile - -o - 2>&1; done | %filecheck %s --check-prefix=TYPES
// RUN: for t in FORMAT-BAD-BRACE FORMAT-BAD-SPEC FORMAT-ARITY FORMAT-I1 FORMAT-NONASCII FORMAT-NUL FORMAT-TOO-MANY; do sed -n "/BEGIN-${t}$/,/END-${t}$/p" %s | not %tla_compile - -o - 2>&1; done | %filecheck %s --check-prefix=FORMAT-ERRORS
// RUN: sed -n '/BEGIN-REGION$/,/END-REGION$/p' %s | not %tla_compile - -o - 2>&1 | %filecheck %s --check-prefix=REGION

// BEGIN-VALID
module {
  tla.func @valid(%i8: i8, %i16: i16, %i: i32, %u8: ui8, %u16: ui16, %u32: ui32, %h: f16, %f: f32) {
    "tla.cube"() ({ tla.debug_print %i8 : i8 }) : () -> ()
    "tla.vector"() ({ tla.debug_print %i16 : i16 }) : () -> ()
    "tla.cube"() ({ tla.debug_print %i : i32 }) : () -> ()
    "tla.vector"() ({ tla.debug_print %u8 : ui8 }) : () -> ()
    "tla.cube"() ({ tla.debug_print %u16 : ui16 }) : () -> ()
    "tla.vector"() ({ tla.debug_print %u32 : ui32 }) : () -> ()
    "tla.cube"() ({ tla.debug_print %h : f16 }) : () -> ()
    "tla.vector"() ({
      tla.debug_print %f : f32
      tla.debug_print format "hello"() : ()
      tla.debug_print format "{} {} {} {} {} {} {} {}"(%i8, %i16, %i, %u8, %u16, %u32, %h, %f) : (i8, i16, i32, ui8, ui16, ui32, f16, f32)
      tla.debug_print format "{{}} % {}"(%i) : (i32)
      "tla.debug_print"() {format = "generic"} : () -> ()
      "tla.debug_print"(%i) {format = "generic {}"} : (i32) -> ()
    }) : () -> ()
    tla.return
  }
}
// END-VALID
// VALID: tla.debug_print %{{.*}} : i8
// VALID: tla.debug_print %{{.*}} : i16
// VALID: tla.debug_print %{{.*}} : i32
// VALID: tla.debug_print %{{.*}} : ui8
// VALID: tla.debug_print %{{.*}} : ui16
// VALID: tla.debug_print %{{.*}} : ui32
// VALID: tla.debug_print %{{.*}} : f16
// VALID: tla.debug_print %{{.*}} : f32
// VALID: tla.debug_print format "hello"() : ()
// VALID: tla.debug_print format "{} {} {} {} {} {} {} {}"(%{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}, %{{.*}}) : (i8, i16, i32, ui8, ui16, ui32, f16, f32)
// VALID: tla.debug_print format "{{.*}} % {{.*}}"(%{{.*}}) : (i32)
// VALID: tla.debug_print format "generic"() : ()
// VALID: tla.debug_print format "generic {}"(%{{.*}}) : (i32)

// BEGIN-I64
module { tla.func @bad(%v: i64) { "tla.vector"() ({ tla.debug_print %v : i64 }) : () -> () tla.return } }
// END-I64
// BEGIN-SI32
module { tla.func @bad(%v: si32) { "tla.vector"() ({ tla.debug_print %v : si32 }) : () -> () tla.return } }
// END-SI32
// BEGIN-UI32
module { tla.func @bad(%v: ui64) { "tla.vector"() ({ tla.debug_print %v : ui64 }) : () -> () tla.return } }
// END-UI32
// BEGIN-F64
module { tla.func @bad(%v: f64) { "tla.vector"() ({ tla.debug_print %v : f64 }) : () -> () tla.return } }
// END-F64
// BEGIN-INDEX
module { tla.func @bad(%v: index) { "tla.vector"() ({ tla.debug_print %v : index }) : () -> () tla.return } }
// END-INDEX
// BEGIN-TENSOR
module { tla.func @bad(%v: tensor<4xi32>) { "tla.vector"() ({ tla.debug_print %v : tensor<4xi32> }) : () -> () tla.return } }
// END-TENSOR
// BEGIN-VECTOR
module { tla.func @bad(%v: vector<4xi32>) { "tla.vector"() ({ tla.debug_print %v : vector<4xi32> }) : () -> () tla.return } }
// END-VECTOR
// BEGIN-PTR
module { tla.func @bad(%v: !tla.ptr<i32, gm, 4>) { "tla.vector"() ({ tla.debug_print %v : !tla.ptr<i32, gm, 4> }) : () -> () tla.return } }
// END-PTR
// TYPES: expected one of f16, f32, i8, i16, i32, u8, u16, u32 scalar, got 'i64'
// TYPES: expected one of f16, f32, i8, i16, i32, u8, u16, u32 scalar, got 'si32'
// TYPES: expected one of f16, f32, i8, i16, i32, u8, u16, u32 scalar, got 'ui64'
// TYPES: expected one of f16, f32, i8, i16, i32, u8, u16, u32 scalar, got 'f64'
// TYPES: expected one of f16, f32, i8, i16, i32, u8, u16, u32 scalar, got 'index'
// TYPES: expected one of f16, f32, i8, i16, i32, u8, u16, u32 scalar, got 'tensor<4xi32>'
// TYPES: expected one of f16, f32, i8, i16, i32, u8, u16, u32 scalar, got 'vector<4xi32>'
// TYPES: expected one of f16, f32, i8, i16, i32, u8, u16, u32 scalar, got '!tla.ptr<i32, gm, 4>'

// BEGIN-FORMAT-BAD-BRACE
module { tla.func @bad(%v: i32) { "tla.vector"() ({ tla.debug_print format "{"() : () }) : () -> () tla.return } }
// END-FORMAT-BAD-BRACE
// BEGIN-FORMAT-BAD-SPEC
module { tla.func @bad(%v: i32) { "tla.vector"() ({ tla.debug_print format "{:d}"(%v) : (i32) }) : () -> () tla.return } }
// END-FORMAT-BAD-SPEC
// BEGIN-FORMAT-ARITY
module { tla.func @bad(%v: i32) { "tla.vector"() ({ tla.debug_print format "{} {}"(%v) : (i32) }) : () -> () tla.return } }
// END-FORMAT-ARITY
// BEGIN-FORMAT-I1
module { tla.func @bad(%v: i1) { "tla.vector"() ({ tla.debug_print format "{}"(%v) : (i1) }) : () -> () tla.return } }
// END-FORMAT-I1
// BEGIN-FORMAT-NONASCII
module { tla.func @bad(%v: i32) { "tla.vector"() ({ tla.debug_print format "snowman \E2\98\83"() : () }) : () -> () tla.return } }
// END-FORMAT-NONASCII
// BEGIN-FORMAT-NUL
module { tla.func @bad(%v: i32) { "tla.vector"() ({ "tla.debug_print"() {format = "bad\00"} : () -> () }) : () -> () tla.return } }
// END-FORMAT-NUL
// BEGIN-FORMAT-TOO-MANY
module { tla.func @bad(%v: i32) { "tla.vector"() ({ tla.debug_print format "{} {} {} {} {} {} {} {} {}"(%v, %v, %v, %v, %v, %v, %v, %v, %v) : (i32, i32, i32, i32, i32, i32, i32, i32, i32) }) : () -> () tla.return } }
// END-FORMAT-TOO-MANY
// FORMAT-ERRORS: malformed format string
// FORMAT-ERRORS: unsupported format field
// FORMAT-ERRORS: format argument count mismatch
// FORMAT-ERRORS: expected one of f16, f32, i8, i16, i32, u8, u16, u32 scalar, got 'i1'
// FORMAT-ERRORS: format string must contain ASCII only
// FORMAT-ERRORS: format string must not contain embedded NUL
// FORMAT-ERRORS: formatted debug_print supports at most 8 operands

// BEGIN-REGION
module { tla.func @regionless(%v: i32) { tla.debug_print %v : i32 tla.return } }
// END-REGION
// REGION: must be nested inside a tla.cube or tla.vector region
