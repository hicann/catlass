// RUN: sed -n '/^\/\/ BEGIN_MODE2_WITH_AIV$/,/^\/\/ END_MODE2_WITH_AIV$/p' %s | sed '1d;$d;s|^// ||' > %t.mode2-with-aiv.mlir && not %tla_compile %t.mode2-with-aiv.mlir -o %t 2>&1 | %filecheck %s --check-prefix=MODE2-WITH-AIV
// RUN: sed -n '/^\/\/ BEGIN_EXHAUSTED$/,/^\/\/ END_EXHAUSTED$/p' %s | sed '1d;$d;s|^// ||' > %t.exhausted.mlir && not %tla_compile %t.exhausted.mlir -o %t 2>&1 | %filecheck %s --check-prefix=EXHAUSTED
// RUN: sed -n '/^\/\/ BEGIN_MODE_MISMATCH$/,/^\/\/ END_MODE_MISMATCH$/p' %s | sed '1d;$d;s|^// ||' > %t.mode-mismatch.mlir && not %tla_compile %t.mode-mismatch.mlir -o %t 2>&1 | %filecheck %s --check-prefix=MODE-MISMATCH

// MODE4-NO-AIV: error:
// MODE4-NO-AIV-SAME: mode 4 requires aiv_id
// MODE2-WITH-AIV: error:
// MODE2-WITH-AIV-SAME: aiv_id is only valid for mode 4
// EXHAUSTED: error:
// EXHAUSTED-SAME: cross flag id exhausted (legal range 0-15; maximum 16 flags)
// Cross-mode dynamic selection is rejected by scf.if's generic type verifier
// (mode 4 flag cannot be yielded as mode 2), not by a flag-specific check.
// MODE-MISMATCH: error:
// MODE-MISMATCH: should match input type

