// RUN: split-file %s %t
// RUN: not %tla_compile %t/unaligned-block.mlir -o - 2>&1 | %filecheck %s --check-prefix=UNALIGNED-BLOCK
// RUN: not %tla_compile %t/dist-unaligned.mlir -o - 2>&1 | %filecheck %s --check-prefix=DIST-UNALIGNED
// RUN: not %tla_compile %t/dist-block.mlir -o - 2>&1 | %filecheck %s --check-prefix=DIST-BLOCK
// RUN: not %tla_compile %t/first-mask.mlir -o - 2>&1 | %filecheck %s --check-prefix=FIRST-MASK

// UNALIGNED-BLOCK: 'tla.store' op unaligned_ub_access and block_stride are mutually exclusive
// DIST-UNALIGNED: 'tla.store' op non-normal store_dist is incompatible with unaligned_ub_access
// DIST-BLOCK: 'tla.store' op non-normal store_dist is incompatible with block_stride
// FIRST-MASK: 'tla.store' op predicate mask is not supported with first_element store_dist

//--- unaligned-block.mlir
!dst = !tla.tensor<!tla.layout<!tla.shape<64>, !tla.stride<1>, !tla.shape<64>, RowMajor>, !tla.coord<0>, !tla.ptr<f32, ub, 4>>
module {
  func.func @bad(%dst: !dst, %source: !tla.vector<64xf32>, %stride: i32) {
    "tla.vec.func"() ({
      "tla.store"(%dst, %source, %stride) <{operandSegmentSizes = array<i32: 1, 1, 0, 1>, unaligned_ub_access}> : (!dst, !tla.vector<64xf32>, i32) -> ()
    }) : () -> ()
    return
  }
}

//--- dist-unaligned.mlir
!dst = !tla.tensor<!tla.layout<!tla.shape<64>, !tla.stride<1>, !tla.shape<64>, RowMajor>, !tla.coord<0>, !tla.ptr<f32, ub, 4>>
module {
  func.func @bad(%dst: !dst, %source: !tla.vector<64xf32>) {
    "tla.vec.func"() ({
      tla.store %dst, %source {store_dist = #tla.store_dist<pack_b32>, unaligned_ub_access} : !dst, !tla.vector<64xf32>
    }) : () -> ()
    return
  }
}

//--- dist-block.mlir
!dst = !tla.tensor<!tla.layout<!tla.shape<64>, !tla.stride<1>, !tla.shape<64>, RowMajor>, !tla.coord<0>, !tla.ptr<f32, ub, 4>>
module {
  func.func @bad(%dst: !dst, %source: !tla.vector<64xf32>, %stride: i32) {
    "tla.vec.func"() ({
      "tla.store"(%dst, %source, %stride) <{operandSegmentSizes = array<i32: 1, 1, 0, 1>, store_dist = #tla.store_dist<pack_b32>}> : (!dst, !tla.vector<64xf32>, i32) -> ()
    }) : () -> ()
    return
  }
}

//--- first-mask.mlir
!dst = !tla.tensor<!tla.layout<!tla.shape<64>, !tla.stride<1>, !tla.shape<64>, RowMajor>, !tla.coord<0>, !tla.ptr<f32, ub, 4>>
module {
  func.func @bad(%dst: !dst, %source: !tla.vector<64xf32>, %mask: !tla.mask<64>) {
    "tla.vec.func"() ({
      tla.store %dst, %source mask %mask {store_dist = #tla.store_dist<first_element_b32>} : !dst, !tla.vector<64xf32> mask !tla.mask<64>
    }) : () -> ()
    return
  }
}

