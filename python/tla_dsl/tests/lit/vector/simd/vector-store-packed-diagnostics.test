// RUN: split-file %s %t
// RUN: not %tla_compile %t/pk-b32-dest-i8.mlir -o - 2>&1 | %filecheck %s --check-prefix=PKB32-DEST-I8
// RUN: not %tla_compile %t/pk-b32-source-i8.mlir -o - 2>&1 | %filecheck %s --check-prefix=PKB32-SOURCE-I8
// RUN: not %tla_compile %t/pk-b16-source-i8.mlir -o - 2>&1 | %filecheck %s --check-prefix=PKB16-SOURCE-I8

// PKB32-DEST-I8: error:
// PKB32-DEST-I8-SAME: 'tla.store' op unsupported pack_b32 source/destination element widths: source 16 bits, destination 8 bits
// PKB32-SOURCE-I8: error:
// PKB32-SOURCE-I8-SAME: 'tla.store' op unsupported pack_b32 source/destination element widths: source 8 bits, destination 16 bits
// PKB16-SOURCE-I8: error:
// PKB16-SOURCE-I8-SAME: 'tla.store' op unsupported pack_b16 source/destination element widths: source 8 bits, destination 8 bits

//--- pk-b32-dest-i8.mlir
!dst_i8 = !tla.tensor<!tla.layout<!tla.shape<128>, !tla.stride<1>, !tla.shape<128>, RowMajor>, !tla.coord<0>, !tla.ptr<i8, ub, 1>>

module {
  func.func @bad_pk_b32_dest_i8(%dst: !dst_i8, %source: !tla.vector<128xi16>) {
    "tla.vec.func"() ({
      tla.store %dst, %source {store_dist = #tla.store_dist<pack_b32>} : !dst_i8, !tla.vector<128xi16>
    }) : () -> ()
    return
  }
}

//--- pk-b32-source-i8.mlir
!dst_f16 = !tla.tensor<!tla.layout<!tla.shape<64>, !tla.stride<1>, !tla.shape<64>, RowMajor>, !tla.coord<0>, !tla.ptr<f16, ub, 2>>

module {
  func.func @bad_pk_b32_source_i8(%dst: !dst_f16, %source: !tla.vector<256xi8>) {
    "tla.vec.func"() ({
      tla.store %dst, %source {store_dist = #tla.store_dist<pack_b32>} : !dst_f16, !tla.vector<256xi8>
    }) : () -> ()
    return
  }
}

//--- pk-b16-source-i8.mlir
!dst_i8 = !tla.tensor<!tla.layout<!tla.shape<128>, !tla.stride<1>, !tla.shape<128>, RowMajor>, !tla.coord<0>, !tla.ptr<i8, ub, 1>>

module {
  func.func @bad_pk_b16_source_i8(%dst: !dst_i8, %source: !tla.vector<256xi8>) {
    "tla.vec.func"() ({
      tla.store %dst, %source {store_dist = #tla.store_dist<pack_b16>} : !dst_i8, !tla.vector<256xi8>
    }) : () -> ()
    return
  }
}
