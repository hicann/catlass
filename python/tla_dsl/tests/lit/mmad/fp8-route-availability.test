// fp8 is a cube *operand* format: the bc layer registers it for GM->L1 and
// L1->L0A/L0B only. Every other route must reject it during route resolution.
//
// This is not a theoretical guard. Element types are shared across all copy
// routes, so giving fp8 a runtime-symbol suffix -- which the cube routes need --
// simultaneously makes every other route able to spell a name for it. Those
// names have no REGISTER_* behind them, so an unguarded route resolves to a
// well-formed callee that fails at link time rather than as a diagnostic here.
//
// The IR below is what a legal Python @tla.kernel program compiles to: an fp8
// tile is fine to build, it is the vector staging route (GM <-> UB) that does
// not exist. The rejection is therefore checked here, in the compiler, on IR the
// frontend did not produce a diagnostic for -- the frontend's own refusal of
// this route is covered by the Python tests.

// RUN: not %tla_compile %s -o - 2>&1 | %filecheck %s --check-prefix=VECCOPY

// The vector pass reports an unsupported route through notifyMatchFailure, which
// is a pattern-dispatch signal rather than a user diagnostic, so what surfaces is
// the generic legalization failure below rather than a message naming fp8. The
// route is correctly rejected either way; only the wording is unhelpful.
// VECCOPY: failed to legalize operation 'tla.copy' that was explicitly marked illegal

module {
  tla.func @fp8_vector_copy(%arg0: !tla.tensor<!tla.layout<!tla.shape<32,32>, !tla.stride<32,1>, !tla.shape<32,32>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f8E4M3FN, gm, 1>>) {
    %0 = tla.alloc_ptr{size_bytes = 1024} -> !tla.ptr<f8E4M3FN, ub, 256>
    %1 = tla.make_shape -> !tla.shape<32,32>
    %2 = tla.make_stride -> !tla.stride<32,1>
    %3 = tla.make_layout %1, %2 : !tla.shape<32,32>, !tla.stride<32,1> -> !tla.layout<!tla.shape<32,32>, !tla.stride<32,1>, !tla.shape<32,32>, RowMajor>
    %4 = tla.make_coord -> !tla.coord<0,0>
    %5 = tla.make_tensor %0, %3, %4 : !tla.ptr<f8E4M3FN, ub, 256>, !tla.layout<!tla.shape<32,32>, !tla.stride<32,1>, !tla.shape<32,32>, RowMajor>, !tla.coord<0,0> -> !tla.tensor<!tla.layout<!tla.shape<32,32>, !tla.stride<32,1>, !tla.shape<32,32>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f8E4M3FN, ub, 256>>
    "tla.vector"() ({
      tla.copy %5, %arg0 : !tla.tensor<!tla.layout<!tla.shape<32,32>, !tla.stride<32,1>, !tla.shape<32,32>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f8E4M3FN, ub, 256>>, !tla.tensor<!tla.layout<!tla.shape<32,32>, !tla.stride<32,1>, !tla.shape<32,32>, RowMajor>, !tla.coord<0,0>, !tla.ptr<f8E4M3FN, gm, 1>>
    }) : () -> ()
    tla.return
  }
}

