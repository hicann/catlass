// RUN: sed -n '/BEGIN-REGION$/,/END-REGION$/p' %s | not %tla_compile - -o - 2>&1 | %filecheck %s --check-prefix=REGION
// RUN: sed -n '/BEGIN-SHAPE-MISMATCH$/,/END-SHAPE-MISMATCH$/p' %s | not %tla_compile - -o - 2>&1 | %filecheck %s --check-prefix=SHAPE-MISMATCH
// RUN: sed -n '/BEGIN-F16$/,/END-F16$/p' %s | not %tla_compile - -o - 2>&1 | %filecheck %s --check-prefix=F16
// RUN: sed -n '/BEGIN-UB$/,/END-UB$/p' %s | not %tla_compile - -o - 2>&1 | %filecheck %s --check-prefix=UB
// RUN: sed -n '/BEGIN-EMPTY$/,/END-EMPTY$/p' %s | not %tla_compile - -o - 2>&1 | %filecheck %s --check-prefix=EMPTY
// RUN: sed -n '/BEGIN-TOO-LARGE$/,/END-TOO-LARGE$/p' %s | not %tla_compile - -o - 2>&1 | %filecheck %s --check-prefix=TOO-LARGE
// RUN: sed -n '/BEGIN-LENGTH-EXCEEDS-SHAPE$/,/END-LENGTH-EXCEEDS-SHAPE$/p' %s | not %tla_compile - -o - 2>&1 | %filecheck %s --check-prefix=LENGTH-EXCEEDS-SHAPE

// BEGIN-REGION
module {
  tla.func @regionless(%x: !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>) {
    tla.print_tensor %x shape = [4] length = 4 : !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>
    tla.return
  }
}
// END-REGION
// REGION: 'tla.print_tensor' op must be nested inside a tla.cube or tla.vector region

// BEGIN-SHAPE-MISMATCH
module {
  tla.func @shape_mismatch(%x: !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>) {
    "tla.vector"() ({
      tla.print_tensor %x shape = [2, 2] length = 4 : !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>
    }) : () -> ()
    tla.return
  }
}
// END-SHAPE-MISMATCH
// SHAPE-MISMATCH: 'tla.print_tensor' op shape must match the tensor layout shape

// BEGIN-F16
module {
  tla.func @f16(%x: !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f16, gm, 4>>) {
    "tla.vector"() ({
      tla.print_tensor %x shape = [4] length = 4 : !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f16, gm, 4>>
    }) : () -> ()
    tla.return
  }
}
// END-F16
// F16: 'tla.print_tensor' op requires a GM float32 tensor

// BEGIN-UB
module {
  tla.func @ub(%x: !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, ub, 4>>) {
    "tla.vector"() ({
      tla.print_tensor %x shape = [4] length = 4 : !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, ub, 4>>
    }) : () -> ()
    tla.return
  }
}
// END-UB
// UB: 'tla.print_tensor' op requires a GM float32 tensor

// BEGIN-EMPTY
module {
  tla.func @empty(%x: !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>) {
    "tla.vector"() ({
      tla.print_tensor %x shape = [] length = 1 : !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>
    }) : () -> ()
    tla.return
  }
}
// END-EMPTY
// EMPTY: 'tla.print_tensor' op shape must not be empty

// BEGIN-TOO-LARGE
module {
  tla.func @too_large(%x: !tla.tensor<!tla.layout<!tla.shape<17>, !tla.stride<1>, !tla.shape<17>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>) {
    "tla.vector"() ({
      tla.print_tensor %x shape = [17] length = 17 : !tla.tensor<!tla.layout<!tla.shape<17>, !tla.stride<1>, !tla.shape<17>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>
    }) : () -> ()
    tla.return
  }
}
// END-TOO-LARGE
// TOO-LARGE: 'tla.print_tensor' op length must be between 1 and 16 elements

// BEGIN-LENGTH-EXCEEDS-SHAPE
module {
  tla.func @length_exceeds_shape(%x: !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>) {
    "tla.vector"() ({
      tla.print_tensor %x shape = [4] length = 5 : !tla.tensor<!tla.layout<!tla.shape<4>, !tla.stride<1>, !tla.shape<4>, row_major>, !tla.coord<0>, !tla.ptr<f32, gm, 4>>
    }) : () -> ()
    tla.return
  }
}
// END-LENGTH-EXCEEDS-SHAPE
// LENGTH-EXCEEDS-SHAPE: 'tla.print_tensor' op length must not exceed the tensor element count
