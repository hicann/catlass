// RUN: sed -n '/^\/\/ BEGIN_LOAD$/,/^\/\/ END_LOAD$/p' %s | sed '1d;$d;s|^// ||' > %t.load.mlir && not %tla_compile %t.load.mlir -o %t 2>&1 | %filecheck %s --check-prefix=LOAD
// RUN: sed -n '/^\/\/ BEGIN_STORE$/,/^\/\/ END_STORE$/p' %s | sed '1d;$d;s|^// ||' > %t.store.mlir && not %tla_compile %t.store.mlir -o %t 2>&1 | %filecheck %s --check-prefix=STORE
// RUN: sed -n '/^\/\/ BEGIN_LOAD_SCOPE$/,/^\/\/ END_LOAD_SCOPE$/p' %s | sed '1d;$d;s|^// ||' > %t.load-scope.mlir && not %tla_compile %t.load-scope.mlir -o %t 2>&1 | %filecheck %s --check-prefix=LOAD-SCOPE
// RUN: sed -n '/^\/\/ BEGIN_STORE_SCOPE$/,/^\/\/ END_STORE_SCOPE$/p' %s | sed '1d;$d;s|^// ||' > %t.store-scope.mlir && not %tla_compile %t.store-scope.mlir -o %t 2>&1 | %filecheck %s --check-prefix=STORE-SCOPE

